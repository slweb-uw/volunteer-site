rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // helper functions
    //
    // Claims are read with get(key, default) rather than dot access: a user who
    // has never been through /api/reconcile-role has no `role` or `authorized`
    // key at all, and a bare lookup on a missing key is an evaluation error that
    // denies the whole rule -- including the branches that should still pass.
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.get("role", "") == "admin";
    }
    function isLead() {
      return isSignedIn() && request.auth.token.get("role", "") == "lead";
    }
    function isStaff() {
      return isAdmin() || isLead();
    }
    // A UW account, or anyone an admin has granted a role. Set server-side by
    // /api/set-roles and /api/reconcile-role; never derived from the client.
    function isAuthorized() {
      return isSignedIn() && request.auth.token.get("authorized", false) == true;
    }

    // Programs permissions -- public, these are the opportunity listings
    match /Alaska/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Idaho/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Montana/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Seattle/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Spokane/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Wyoming/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // events permissions
    match /events/{eventId} {
      // Public: the calendar and opportunity pages are browsable signed out.
      allow read: if true;
      // The signup counter moved to the slots subcollection, so nothing on the
      // event document itself is volunteer-writable any more.
      allow create, update, delete: if isStaff();

      // volunteers subcollection permissions
      match /volunteers/{volunteerId} {
        allow read: if isAuthorized();
        // Document id is `${uid}_${YYYY-MM-DD}` -- one signup per person per
        // day. The id check is what stops a volunteer touching anyone else's
        // record; the uid check stops the payload disagreeing with the id.
        allow create, update: if isStaff() || (isAuthorized()
          && volunteerId.matches(request.auth.uid + "_.*")
          && request.resource.data.uid == request.auth.uid);
        allow delete: if isStaff() || (isAuthorized()
          && volunteerId.matches(request.auth.uid + "_.*"));
      }

      // slots subcollection permissions
      match /slots/{slotId} {
        allow read: if isAuthorized();
        allow create, delete: if isStaff();
        // Signup and withdrawal move `remaining` by one, in a transaction that
        // also writes the volunteer document. Rules are evaluated per document
        // and cannot bind the two together, so this bounds the damage instead:
        // capacity is untouchable, the count stays inside [0, capacity], and it
        // can only ever step by one. A volunteer can still desync the counter
        // from the roster by one; they cannot invent or destroy a slot.
        allow update: if isStaff() || (isAuthorized()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["remaining"])
          && request.resource.data.remaining is int
          && request.resource.data.remaining >= 0
          && request.resource.data.remaining <= resource.data.capacity
          && (request.resource.data.remaining == resource.data.remaining + 1
              || request.resource.data.remaining == resource.data.remaining - 1));
      }
    }

    // Admins permission
    match /Admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // Leads permission
    match /Leads/{leadId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // Volunteers aka non-uw volunteers granted access by an admin
    match /Volunteers/{volunteerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Volunteer log (#225): an append-only record of signups, edits,
    // withdrawals, removals and event archives, kept so we can answer public
    // records requests. Entries are written from the browser in the same
    // transaction as the change they describe. Nobody can edit or delete one,
    // admins included; only the Admin SDK (the backfill script) bypasses this.
    //
    // Rules cannot tie a log write to the volunteer write beside it, so this
    // proves who wrote the entry and stops forgery of the actor, the role and
    // the time. It cannot force a determined user to log at all.
    function logActorRole() {
      return isAdmin() ? "admin" : (isLead() ? "lead" : "volunteer");
    }
    function isValidLogEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(["action", "at", "actorUid", "actorEmail", "actorRole",
          "subjectUid", "subjectEmail", "volunteer", "changes", "eventId",
          "shiftDate", "shiftYear", "event"])
        && d.keys().hasAll(["action", "at", "actorUid", "actorEmail", "actorRole",
          "subjectUid", "subjectEmail", "volunteer", "changes", "eventId",
          "shiftDate", "shiftYear", "event"])
        && d.actorUid == request.auth.uid
        && d.actorRole == logActorRole()
        && d.actorEmail == request.auth.token.get("email", "").lower()
        && d.at == request.time
        && d.eventId is string
        && d.shiftDate is string && d.shiftDate.size() == 10
        && d.shiftYear is int
        && d.event is map
        && (d.volunteer == null || d.volunteer is map)
        && (d.changes == null || d.changes is map);
    }
    match /volunteerLog/{entryId} {
      allow read: if isAdmin();
      // "backfill" is deliberately absent: only the script writes those.
      allow create: if (isStaff() || isAuthorized()) && isValidLogEntry()
        && ((isStaff()
              && request.resource.data.action in
                ["signup", "update", "withdraw", "remove", "event_archived"])
            || (request.resource.data.subjectUid == request.auth.uid
              && request.resource.data.action in ["signup", "update", "withdraw"]));
      allow update, delete: if false;
    }

    // caches permissions
    match /cache/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
